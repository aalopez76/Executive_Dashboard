# Variables de entorno del dashboard. Copiar a `.env` y ajustar. NO commitear `.env`.

# Ruta a la BD SQLite. Si se omite, app.get_db_path() usa una ruta relativa al submódulo
# (ojo: por defecto apunta a una copia un nivel por encima del repo; en local/CI conviene fijarla aquí).
DB_PATH=./SQL-Connection-Module/examples/toys_and_models.sqlite

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=WARNING

# Puerto del servidor de producción (gunicorn / wsgi:server)
PORT=8050
